{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build --workspace @voz-publica/api && npm run build:web --workspace @voz-publica/mobile",
  "outputDirectory": "apps/mobile/dist",
  "cleanUrls": true,
  "functions": {
    "api/index.ts": {
      "includeFiles": "apps/api/prisma/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__api_path=:path*" },
    {
      "source": "/representatives/:id/expenses",
      "destination": "/representatives/%5Bid%5D/expenses"
    },
    {
      "source": "/representatives/:id",
      "destination": "/representatives/%5Bid%5D"
    },
    {
      "source": "/sources/:id",
      "destination": "/sources/%5Bid%5D"
    },
    { "source": "/proposals/:id", "destination": "/proposals/%5Bid%5D" },
    { "source": "/votes/:id", "destination": "/votes/%5Bid%5D" }
  ]
}
